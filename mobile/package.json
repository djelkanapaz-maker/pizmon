{
  "name": "paskol-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "iOS + Android shell (Capacitor) for פסקול (Paskol)",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#F8F4ED' --iconBackgroundColorDark '#F8F4ED' --splashBackgroundColor '#F8F4ED' --splashBackgroundColorDark '#F8F4ED'",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "typescript": "^7.0.2"
  }
}
