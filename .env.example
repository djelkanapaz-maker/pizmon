# ── Web app (all values are public / browser-safe) ──
# Supabase project URL and publishable (anon) key — Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Public URL of this deployment (used for password-reset redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: product name shown before sign-in (after sign-in the company's brand_name is used).
NEXT_PUBLIC_BRAND_NAME=WEDDING MUSIC CLUB

# ── NOT for the web app ──
# The service-role key is never used by Next.js. It is injected automatically into the
# `admin-users` edge function by Supabase. Set these as *edge function secrets*:
#   BOOTSTRAP_SECRET   one-time secret that allows creating the first company admin
#   APP_URL            public URL of this deployment (activation links point here)
#   RESEND_API_KEY     optional — email activation links (otherwise admins share links manually)
#   EMAIL_FROM         optional — e.g. "Wedding Music Club <hello@yourdomain.com>"
